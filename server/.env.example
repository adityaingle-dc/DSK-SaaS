PORT=5000
# Local MongoDB or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/dsk_surveys
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Used by `npm run seed` to create the first admin
SEED_ADMIN_EMAIL=admin@bank.local
SEED_ADMIN_PASSWORD=Admin@123

# Uploaded document scans/photos (default: server/uploads)
# UPLOAD_DIR=/var/lib/dsk/uploads
